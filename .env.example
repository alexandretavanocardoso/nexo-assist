# --- Modelo (obrigatório para o agent responder) ---
# Chave da API da Anthropic: https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Modelo pequeno e rápido por padrão. Troque por claude-sonnet-5-5 se quiser comparar.
NEXO_MODEL=claude-haiku-5-5
# Esforço de raciocínio do modelo (low | medium | high). "low" = respostas mais rápidas e baratas.
NEXO_EFFORT=low

# --- Sessão ---
# Segredo usado para assinar o cookie de sessão. Gere um valor aleatório em produção:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=troque-este-segredo-em-producao

# --- Persistência ---
DATABASE_PATH=./data/nexo.db

# --- Sistema de chamados simulado (legado) ---
# Chance de cada chamada ao sistema de chamados iniciar uma "queda" (0 a 1).
TICKETS_OUTAGE_RATE=0.08
# Duração de cada queda, em milissegundos.
TICKETS_OUTAGE_MS=3000
# Latência simulada de cada chamada, em milissegundos.
TICKETS_LATENCY_MS=150

# --- Limites de uso ---
# Mensagens por minuto por funcionário (proteção de custo e abuso).
RATE_LIMIT_PER_MINUTE=8

# --- Teto global de mensagens processadas por dia (protege o custo de um deploy público) ---
DAILY_MESSAGE_LIMIT=1000

# --- Logs (debug | info | warn | error) ---
LOG_LEVEL=info
